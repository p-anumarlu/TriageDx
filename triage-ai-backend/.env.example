# ─── triage.ai  Environment Configuration ───────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ─── Database ────────────────────────────────────────────────────────────────
# Development (SQLite — zero setup):
DATABASE_URL=sqlite+aiosqlite:///./triage.db
# Production (PostgreSQL — required for HIPAA-compliant deployments):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/triageai

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-secure-64-char-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# ─── Google AI Studio ────────────────────────────────────────────────────────
# Free tier: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=your-google-ai-studio-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Google Maps Platform — for nearby facility finder
# Get at: https://console.cloud.google.com/apis/library/places-backend.googleapis.com
# Enable "Places API". Free tier: $200/month credit (~6,700 nearby-search calls).
# If blank, the app falls back to free OpenStreetMap (Overpass API) — no key needed.
GOOGLE_MAPS_API_KEY=

# ─── App ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development             # development | production
HIPAA_AUDIT_LOG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Security ──────────────────────────────────────────────────────────────────
# Admin API key — required to access /admin/analytics
# Generate: python -c "import secrets; print(secrets.token_hex(24))"
API_KEY=
